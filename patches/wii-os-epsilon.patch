+
+KDColor s_band[k_screenWidth * Band::k_maxHeight];
+
+/* Text is rasterized white on black in this buffer; the green channel is
+ * then the glyph coverage, used to blend the text over what is below. The
+ * buffer also receives decompressed .nwa icons (never at the same time). */
+constexpr int k_textBufferWidth = 240;
+constexpr int k_textBufferHeight = 18;
+KDColor s_textBuffer[k_textBufferWidth * k_textBufferHeight];
+
+constexpr int k_nwaIconWidth = 55;
+constexpr int k_nwaIconHeight = 56;
+static_assert(k_nwaIconWidth * k_nwaIconHeight <=
+                  k_textBufferWidth * k_textBufferHeight,
+              "The text buffer must be able to hold a .nwa icon");
+
+class TextContext : public KDContext {
+ public:
+  TextContext()
+      : KDContext(KDPointZero,
+                  KDRect(0, 0, k_textBufferWidth, k_textBufferHeight)) {}
+
+ protected:
+  void pushRect(KDRect rect, const KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             pixels + j * rect.width(), rect.width() * sizeof(KDColor));
+    }
+  }
+  void pushRectUniform(KDRect rect, KDColor color) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      KDColor* r = s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x();
+      for (KDCoordinate i = 0; i < rect.width(); i++) {
+        r[i] = color;
+      }
+    }
+  }
+  void pullRect(KDRect rect, KDColor* pixels) override {
+    for (KDCoordinate j = 0; j < rect.height(); j++) {
+      memcpy(pixels + j * rect.width(),
+             s_textBuffer + (rect.y() + j) * k_textBufferWidth + rect.x(),
+             rect.width() * sizeof(KDColor));
+    }
+  }
+};
+
+inline int clampi(int v, int lo, int hi) {
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+inline void blendPixel(KDColor* p, KDColor c, int alpha) {
+  if (alpha >= 256) {
+    *p = c;
+  } else if (alpha > 0) {
+    *p = KDColor::Blend(c, *p, static_cast<uint8_t>(alpha > 255 ? 255 : alpha));
+  }
+}
+
+/* Wallpaper: a radial "bloom" quantized into rings, like the reference
+ * screenshots. The colour of each ring is in a small table indexed by the
+ * squared distance to the centre. */
+constexpr int k_wallpaperShift = 8;
+constexpr int k_wallpaperSteps = 256;
+KDColor s_wallpaper[k_wallpaperSteps];
+int s_wallpaperCenterX = 200;
+int s_wallpaperCenterY = 112;
+
+struct WallpaperStyle {
+  uint32_t center, middle, edge;
+  int cx, cy;
+};
+
+constexpr WallpaperStyle k_wallpapers[k_numberOfWallpapers] = {
+    {0x8FD3F4, 0x2E7BE0, 0x0A2C8C, 200, 112},  // Bloom
+    {0x4E8C8A, 0x1E4A5C, 0x0A1A30, 210, 100},  // Night sky
+    {0xFFC48A, 0xD9576B, 0x3A1450, 160, 150},  // Sunset
+    {0xA8E08C, 0x2F8F5B, 0x0B3326, 120, 90},   // Forest
+};
+
+KDColor lerp(uint32_t a, uint32_t b, float t) {
+  int ra = (a >> 16) & 255, ga = (a >> 8) & 255, ba = a & 255;
+  int rb = (b >> 16) & 255, gb = (b >> 8) & 255, bb = b & 255;
+  return KDColor::RGB888(static_cast<uint8_t>(ra + (rb - ra) * t),
+                         static_cast<uint8_t>(ga + (gb - ga) * t),
+                         static_cast<uint8_t>(ba + (bb - ba) * t));
+}
+
+}  // namespace
+
+/* ------------------------------------------------------------------ rect */
+
+Rect Rect::intersection(const Rect& o) const {
+  int x0 = x > o.x ? x : o.x;
+  int y0 = y > o.y ? y : o.y;
+  int x1 = right() < o.right() ? right() : o.right();
+  int y1 = bottom() < o.bottom() ? bottom() : o.bottom();
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
+/* ------------------------------------------------------------------ band */
+
+void Band::begin(Rect area) {
+  m_area = area;
+  m_clip = area;
+}
+
+bool Band::setClip(Rect r) {
+  m_clip = r.intersection(m_area);
+  return !m_clip.isEmpty();
+}
+
+KDColor* Band::row(int y) const {
+  return s_band + (y - m_area.y) * m_area.w - m_area.x;
+}
+
+const KDColor* Band::pixels() const { return s_band; }
+
+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = KDColor::Blend(c, row[x], static_cast<uint8_t>(alpha));
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. */
+static int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  // Distance in 1/16 pixel from the corner centre
+  float dx = (px - cx) + (px < cx ? 0.5f : -0.5f);
+  float dy = (py - cy) + (py < cy ? 0.5f : -0.5f);
+  float d = sqrtf(dx * dx + dy * dy);
+  float edge = radius + 0.5f - d;
+  if (edge >= 1.f) {
+    return 256;
+  }
+  if (edge <= 0.f) {
+    return 0;
+  }
+  return static_cast<int>(edge * 256);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = r.inset(1);
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void shadow(Band& b, Rect r, int radius, int strength) {
+  for (int i = 3; i >= 1; i--) {
+    Rect s = {r.x - i + 1, r.y - i + 3, r.w + 2 * i - 2, r.h + 2 * i - 2};
+    roundFill(b, s, radius + i, KDBlack, strength / (i + 1));
+  }
+}
+
+void mask(Band& b, const WinIcons::Mask& m, int x, int y, KDColor c,
+          int alpha) {
+  Rect z = Rect{x, y, m.size, m.size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* src = m.data + (yy - y) * m.size - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx];
+      if (a) {
+        blendPixel(row + xx, c, (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tile(Band& b, int icon, int size, int x, int y, int alpha) {
+  const uint16_t* colors;
+  const uint8_t* alphas;
+  if (size == WinIcons::k_tile24Size) {
+    colors = WinIcons::k_tile24Colors;
+    alphas = WinIcons::k_tile24Alphas;
+  } else if (size == WinIcons::k_tile20Size) {
+    colors = WinIcons::k_tile20Colors;
+    alphas = WinIcons::k_tile20Alphas;
+  } else {
+    size = WinIcons::k_tile14Size;
+    colors = WinIcons::k_tile14Colors;
+    alphas = WinIcons::k_tile14Alphas;
+  }
+  colors += icon * size * size;
+  alphas += icon * size * size;
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int offset = (yy - y) * size - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[offset + xx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(colors[offset + xx]),
+                   a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    int s = size >= 24 ? 24 : (size >= 20 ? 20 : 14);
+    tile(b, WinIcons::TileGame, s, x + (size - s) / 2, y + (size - s) / 2);
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  // Rounded corners like the other tiles
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  return KDFont::Font(font)->stringSize(s).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth) {
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  // Cut the text so that it fits in maxWidth (and in the buffer)
+  constexpr int k_maxChars = 40;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit = (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = (limit < k_maxChars ? limit : k_maxChars) - 1;
+    if (keep < 1) {
+      keep = 1;
+    }
+    // Do not cut a UTF-8 sequence in the middle
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    // Cut like the reference ("Calcul", "Equati"), with no ellipsis
+    keep++;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+void pointer(Band& b, int x, int y) {
+  using namespace WinIcons;
+  Rect z = Rect{x, y, k_cursorWidth, k_cursorHeight}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* src = k_cursor + (yy - y) * k_cursorWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      if (src[xx] == 1) {
+        row[xx] = KDBlack;
+      } else if (src[xx] == 2) {
+        row[xx] = KDWhite;
+      }
+    }
+  }
+}
+
+/* ------------------------------------------------------------- wallpaper */
+
+void prepareWallpaper(int theme) {
+  const WallpaperStyle& s = k_wallpapers[clampi(theme, 0, k_numberOfWallpapers - 1)];
+  s_wallpaperCenterX = s.cx;
+  s_wallpaperCenterY = s.cy;
+  // Distance (in pixels) at which the edge colour is reached
+  constexpr float k_radius = 230.f;
+  constexpr int k_rings = 22;
+  for (int i = 0; i < k_wallpaperSteps; i++) {
+    float d = sqrtf(static_cast<float>(i << k_wallpaperShift)) / k_radius;
+    // Quantize into rings
+    d = floorf(d * k_rings) / k_rings;
+    if (d > 1.f) {
+      d = 1.f;
+    }
+    KDColor c = d < 0.45f ? lerp(s.center, s.middle, d / 0.45f)
+                          : lerp(s.middle, s.edge, (d - 0.45f) / 0.55f);
+    s_wallpaper[i] = c;
+  }
+}
+
+void wallpaper(Band& b) {
+  const Rect& z = b.clip();
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int dy = y - s_wallpaperCenterY;
+    int dy2 = dy * dy;
+    for (int x = z.x; x < z.right(); x++) {
+      int dx = x - s_wallpaperCenterX;
+      int i = (dx * dx + dy2) >> k_wallpaperShift;
+      row[x] = s_wallpaper[i < k_wallpaperSteps ? i : k_wallpaperSteps - 1];
+    }
+  }
+}
+
+}  // namespace Win
+}  // namespace Home
diff --git a/epsilon/apps/home/win/gfx.h b/epsilon/apps/home/win/gfx.h
new file mode 100644
index 0000000000..3657031b98
--- /dev/null
+++ b/epsilon/apps/home/win/gfx.h
@@ -0,0 +1,93 @@
+#pragma once
+
+/* Windows-OS drawing primitives.
+ *
+ * The desktop is composed in RAM one horizontal band at a time (wallpaper,
+ * windows, taskbar, menus, mouse pointer) and every finished band is pushed to
+ * the LCD in one go: no flicker, and redrawing a small dirty rectangle (the
+ * pointer, a button) only costs that rectangle. */
+
+#include <ion/display.h>
+#include <ion/external_apps.h>
+#include <kandinsky/color.h>
+#include <kandinsky/font.h>
+#include <stdint.h>
+
+#include "win_icons.h"
+
+namespace Home {
+namespace Win {
+
+constexpr int k_screenWidth = Ion::Display::Width;
+constexpr int k_screenHeight = Ion::Display::Height;
+
+struct Rect {
+  int x, y, w, h;
+  int right() const { return x + w; }
+  int bottom() const { return y + h; }
+  bool isEmpty() const { return w <= 0 || h <= 0; }
+  bool contains(int px, int py) const {
+    return px >= x && py >= y && px < x + w && py < y + h;
+  }
+  bool intersects(const Rect& o) const {
+    return x < o.right() && o.x < right() && y < o.bottom() && o.y < bottom();
+  }
+  Rect intersection(const Rect& o) const;
+  Rect inset(int d) const { return {x + d, y + d, w - 2 * d, h - 2 * d}; }
+  Rect translated(int dx, int dy) const { return {x + dx, y + dy, w, h}; }
+};
+
+constexpr Rect k_screen = {0, 0, k_screenWidth, k_screenHeight};
+
+// The band being composed, and the clipping rectangle inside it
+class Band {
+ public:
+  constexpr static int k_maxHeight = 12;
+  void begin(Rect area);
+  const Rect& area() const { return m_area; }
+  const Rect& clip() const { return m_clip; }
+  // Restricts drawing to r (intersected with the band). Returns false if empty.
+  bool setClip(Rect r);
+  void resetClip() { m_clip = m_area; }
+  // Pointer to pixel (0, y) of the band, valid for x in [area.x, area.right)
+  KDColor* row(int y) const;
+  const KDColor* pixels() const;
+
+ private:
+  Rect m_area;
+  Rect m_clip;
+};
+
+enum class Align : uint8_t { Left, Center, Right };
+
+void fill(Band& b, Rect r, KDColor c, int alpha = 256);
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void frame(Band& b, Rect r, KDColor c, int alpha = 256);
+// Soft drop shadow around r
+void shadow(Band& b, Rect r, int radius, int strength);
+void mask(Band& b, const WinIcons::Mask& m, int x, int y, KDColor c,
+          int alpha = 256);
+// Coloured app tile; size is 24, 20 or 14
+void tile(Band& b, int icon, int size, int x, int y, int alpha = 256);
+// Icon of an external app (.nwa), scaled to size x size
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size);
+// Text whose top-left corner is (x, y), cut at maxWidth pixels ("..." added)
+void text(Band& b, const char* s, int x, int y, KDColor c,
+          KDFont::Size font = KDFont::Size::Small, Align align = Align::Left,
+          int maxWidth = k_screenWidth);
+int textWidth(const char* s, KDFont::Size font = KDFont::Size::Small);
+int glyphWidth(KDFont::Size font = KDFont::Size::Small);
+int glyphHeight(KDFont::Size font = KDFont::Size::Small);
+void pointer(Band& b, int x, int y);
+
+// Wallpapers
+constexpr int k_numberOfWallpapers = 4;
+void prepareWallpaper(int theme);
+void wallpaper(Band& b);
+
+inline KDColor rgb(uint32_t c) { return KDColor::RGB24(c); }
+
+}  // namespace Win
+}  // namespace Home
