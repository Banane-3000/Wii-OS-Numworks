+
+void drawDialogButton(Band& b, Rect r, const char* label, bool hot,
+                      bool primary) {
+  roundFill(b, r, 19, hot ? rgb(0xE6F6FD) : rgb(0xF6F8F9));
+  roundFill(b, {r.x + 3, r.y + 2, r.w - 6, r.h / 2 - 1}, 16, KDWhite, 190);
+  roundFrame(b, r, 19, accent());
+  roundFrame(b, r.inset(1), 18, accent(), hot || primary ? 200 : 90);
+  if (hot) {
+    if (s.fist) {
+      roundFill(b, r.inset(2), 17, accent(), 90);
+    }
+    roundFrame(b, r.inset(-1), 20, accent(), 150);
+  }
+  text(b, label, r.x + r.w / 2, r.y + 10, accentDark(), KDFont::Size::Large,
+       Align::Center, r.w - 6);
+}
+
+void drawDialog(Band& b) {
+  if (s.dialog.isNone()) {
+    return;
+  }
+  // The menu fades behind the window, like on the real console
+  fill(b, k_screen, KDWhite, 120);
+  Rect d = k_dialog;
+  shadow(b, d, 16, 70);
+  roundFill(b, d, 16, rgb(0xF7F8F9));
+  roundFill(b, {d.x + 3, d.y + 3, d.w - 6, 44}, 14, KDWhite, 200);
+  roundFrame(b, d, 16, rgb(0xB4D9E8));
+  roundFrame(b, d.inset(1), 15, KDWhite);
+  drawItemIcon(b, s.dialog, 24, d.x + d.w / 2 - 12, d.y + 14);
+  char msg[40];
+  int n = 0;
+  for (const char* p = "Start "; *p; p++) {
+    msg[n++] = *p;
+  }
+  const char* label = itemLabel(s.dialog);
+  for (int i = 0; label[i] && i < 24; i++) {
+    msg[n++] = label[i];
+  }
+  msg[n++] = '?';
+  msg[n] = 0;
+  text(b, msg, d.x + d.w / 2, d.y + 58, textTile(), KDFont::Size::Large,
+       Align::Center, d.w - 16);
+  drawDialogButton(b, k_startRect, "Start", s.hover == k_hitStart, true);
+  drawDialogButton(b, k_backRect, "Wii Menu", s.hover == k_hitBack, false);
+}
