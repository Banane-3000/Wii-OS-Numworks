+def emit_array(out, ctype, name, values, per_line=24):
+    out.append(f"constexpr {ctype} {name}[{len(values)}] = {{")
+    for i in range(0, len(values), per_line):
+        out.append("  " + ", ".join(str(v) for v in values[i:i + per_line]) + ",")
+    out.append("};")
+
+
+def rgb565(r, g, b):
+    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
+
+
+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+    out_path = sys.argv[1]
+    preview = sys.argv[sys.argv.index("--preview") + 1] if "--preview" in sys.argv else None
+
+    out = ["// Generated by apps/home/win/gen_icons.py - do not edit",
+           "#pragma once", "#include <stdint.h>", "",
+           "namespace Home {", "namespace WinIcons {", ""]
+
+    out.append("enum Tile : uint8_t {")
+    for i, (name, *_rest) in enumerate(TILES):
+        out.append(f"  Tile{name} = {i},")
+    out.append(f"  NumberOfTiles = {len(TILES)}")
+    out.append("};")
+    out.append("")
+
+    previews = []
+    for size in TILE_SIZES:
+        colors, alphas = [], []
+        row = []
+        for (name, c1, c2, fn) in TILES:
+            img = render_tile(c1, c2, fn, size)
+            row.append(img)
+            for (r, g, b, a) in img.getdata():
+                colors.append(rgb565(r, g, b) if a else 0)
+                alphas.append(a)
+        previews.append(row)
+        out.append(f"constexpr int k_tile{size}Size = {size};")
+        emit_array(out, "uint16_t", f"k_tile{size}Colors", colors)
+        emit_array(out, "uint8_t", f"k_tile{size}Alphas", alphas)
+        out.append("")
+
+    out.append("struct Mask {")
+    out.append("  uint8_t size;")
+    out.append("  const uint8_t* data;")
+    out.append("};")
+    out.append("")
+    mask_imgs = []
+    for (name, size, fn) in MASKS:
+        img = render_mask(fn, size)
+        mask_imgs.append(img)
+        emit_array(out, "uint8_t", f"k_mask{name}Data", list(img.getdata()))
+        out.append(f"constexpr Mask k_mask{name} = {{{size}, k_mask{name}Data}};")
+    out.append("")
+
+    w = max(len(r) for r in CURSOR)
+    h = len(CURSOR)
+    cursor = []
+    for line in CURSOR:
+        line = line.ljust(w)
+        for ch in line:
+            cursor.append(1 if ch == "#" else (2 if ch == "." else 0))
+    out.append(f"constexpr int k_cursorWidth = {w};")
+    out.append(f"constexpr int k_cursorHeight = {h};")
+    out.append("// 0: transparent, 1: outline, 2: fill")
+    emit_array(out, "uint8_t", "k_cursor", cursor)
+    out.append("")
+    out.append("}  // namespace WinIcons")
+    out.append("}  // namespace Home")
+    with open(out_path, "w") as f:
+        f.write("\n".join(out) + "\n")
+
+    if preview:
+        cols = len(TILES)
+        sheet = Image.new("RGBA", (cols * 30 + 10, 3 * 30 + 40 + 30), (40, 60, 120, 255))
+        for j, row in enumerate(previews):
+            for i, img in enumerate(row):
+                sheet.alpha_composite(img, (10 + i * 30, 10 + j * 30))
+        for i, img in enumerate(mask_imgs):
+            white = Image.new("RGBA", img.size, (255, 255, 255, 255))
+            sheet.paste(white, (10 + i * 24, 110), img)
+        sheet = sheet.resize((sheet.width * 3, sheet.height * 3), Image.NEAREST)
+        sheet.save(preview)
+
+
+if __name__ == "__main__":
+    main()
