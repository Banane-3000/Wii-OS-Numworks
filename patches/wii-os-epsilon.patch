+
+void enter() {
+  buildItems();
+  if (!s.initialized) {
+    s.initialized = true;
+    s.cursorX = 160;
+    s.cursorY = 90;
+    s.page = 0;
+    s.lastBattery = batteryPercent();
+  }
+  if (s.page >= pageCount()) {
+    s.page = pageCount() - 1;
+  }
+  s.dialog = k_noItem;
+  s.fist = false;
+  s.hover = hitTest(s.cursorX, s.cursorY);
+  s_launch = k_noItem;
+}
+
+void leave() {}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha || e == Events::AlphaCaps) {
+    return false;
+  }
+  if (e == Events::Left) {
+    movePointer(-1, 0, 1);
+  } else if (e == Events::Right) {
+    movePointer(1, 0, 2);
+  } else if (e == Events::Up) {
+    movePointer(0, -1, 3);
+  } else if (e == Events::Down) {
+    movePointer(0, 1, 4);
+  } else if (e == Events::OK || e == Events::EXE) {
+    click(false);
+  } else if (e == Events::Toolbox) {
+    click(true);
+  } else if (e == Events::Back || e == Events::Home) {
+    if (!s.dialog.isNone()) {
+      closeDialog();
+    } else if (s.page != 0) {
+      changePage(-s.page);
+    }
+  }
+  // Other keys are swallowed so that they do not leave the menu
+  return true;
+}
+
+bool tick() {
+  s.ticks++;
+  bool redraw = false;
+  if (s.fist) {
+    s.fist = false;
+    invalidate(pointerRect(s.cursorX, s.cursorY));
+    invalidate(hitRect(s.hover));
+    redraw = true;
+  }
+  if (s.ticks % 10 == 0) {
+    int pc = batteryPercent();
+    if (pc != s.lastBattery) {
+      s.lastBattery = pc;
+      invalidate(k_clockArea);
+      redraw = true;
+    }
+  }
+  return redraw;
+}
+
+void render(Band& b) {
+  drawBackground(b);
+  for (int cell = 0; cell < k_cellsPerPage; cell++) {
+    drawCell(b, cell);
+  }
+  if (s.page > 0) {
+    drawPeek(b, false);
+    drawArrow(b, k_prevRect, false, s.hover == k_hitPrev);
+  }
+  if (s.page < pageCount() - 1) {
+    drawPeek(b, true);
+    drawArrow(b, k_nextRect, true, s.hover == k_hitNext);
+  }
+  drawBottomBar(b);
+  drawDialog(b);
+  drawHand(b, s.cursorX, s.cursorY);
+}
+
+}  // namespace Shell
+
+}  // namespace Win
+}  // namespace Home
