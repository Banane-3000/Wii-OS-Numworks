+
+/* Wii-OS: a Wii Menu look-alike home screen. A grid of "channels" (the
+ * calculator apps and the .nwa games), a pointer moved with the arrow keys,
+ * a start dialog, a battery gauge, a Wii button (Settings) and a message button
+ * (sleep). Everything here is drawn from scratch with the Win::gfx
+ * primitives; no Nintendo asset is used. */
+
+namespace Home {
+namespace Win {
+
+namespace {
+
+using Ion::Events::Event;
+namespace Events = Ion::Events;
+using KDFont::Size::Small;
+
+void (*s_invalidator)(Rect) = nullptr;
+Item s_launch = k_noItem;
+
+/* ----------------------------------------------------------------- layout */
+
+constexpr int k_columns = 4;
+constexpr int k_rows = 3;
+constexpr int k_cellsPerPage = k_columns * k_rows;
+constexpr int k_tileW = 64;
+constexpr int k_tileH = 46;
+constexpr int k_gapX = 4;
+constexpr int k_gapY = 4;
+constexpr int k_gridX = 28;
+constexpr int k_gridY = 21;
+constexpr int k_barY = 173;     // top edge of the bottom bar (sides)
+constexpr int k_dip = 26;       // how far the bar edge sags under the gauge
+                                // (negative = bump instead of dip)
+
+constexpr Rect k_gridArea = {0, 0, k_screenWidth, 172};
+constexpr Rect k_prevRect = {2, 70, 16, 44};
+constexpr Rect k_nextRect = {289, 70, 16, 44};
+constexpr Rect k_wiiRect = {19, 182, 40, 40};
+constexpr Rect k_sdRect = {68, 196, 26, 28};
+constexpr Rect k_mailRect = {263, 182, 40, 40};
+constexpr Rect k_clockArea = {96, 172, 128, 54};
+constexpr Rect k_dialog = {40, 36, 240, 150};
+constexpr Rect k_startRect = {58, 134, 98, 38};
+constexpr Rect k_backRect = {164, 134, 98, 38};
+
+constexpr int k_hitNone = 0;
+constexpr int k_hitPrev = 1;
+constexpr int k_hitNext = 2;
+constexpr int k_hitWii = 3;
+constexpr int k_hitMail = 4;
+constexpr int k_hitStart = 7;
+constexpr int k_hitBack = 8;
+constexpr int k_hitSD = 9;
+constexpr int k_hitTile = 100;  // + cell
+
+/* ----------------------------------------------------------------- colors */
+
+KDColor accent() { return rgb(0x7BC6E0); }
+KDColor accentDark() { return rgb(0x1790C4); }
+KDColor background() { return rgb(0xE9E9E9); }
+KDColor backgroundStripe() { return rgb(0xE3E3E3); }
