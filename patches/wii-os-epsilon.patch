+def tile(color, color2=None):
+    """Rounded square with a soft vertical gradient."""
+    c = Canvas()
+    top = rgb(color)
+    bottom = rgb(color2 if color2 is not None else color)
+    grad = Image.new("RGBA", (c.n, c.n))
+    gd = ImageDraw.Draw(grad)
+    for y in range(c.n):
+        t = y / (c.n - 1)
+        gd.line([(0, y), (c.n, y)], fill=tuple(int(top[i] * (1 - t) + bottom[i] * t) for i in range(4)))
+    mask = Image.new("L", (c.n, c.n), 0)
+    ImageDraw.Draw(mask).rounded_rectangle(c.box(2, 2, 98, 98), radius=c.s(20), fill=255)
+    c.img.paste(grad, (0, 0), mask)
+    return c
