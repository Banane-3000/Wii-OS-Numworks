+void drawHand(Band& b, int x, int y) {
+  const bool fist = s.fist;
+  const uint16_t* colors = fist ? k_fistColor : k_openColor;
+  const uint8_t* alphas = fist ? k_fistAlpha : k_openAlpha;
+  Rect hr = {x - (fist ? k_fistHotX : k_openHotX),
+             y - (fist ? k_fistHotY : k_openHotY), k_handW, k_handH};
+  Rect z = hr.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int offset = (yy - hr.y) * k_handW - hr.x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[offset + xx];
+      if (a >= 250) {
+        row[xx] = KDColor::RGB16(colors[offset + xx]);
+      } else if (a > 0) {
+        row[xx] = KDColor::Blend(KDColor::RGB16(colors[offset + xx]), row[xx],
+                                 static_cast<uint8_t>(a));
+      }
+    }
+  }
+}
