+
+/* ------------------------------------------------------------------ state */
+
+struct State {
+  bool initialized;
+  int cursorX, cursorY;
+  int page;
+  Item dialog;
+  int hover;
+  int lastBattery;
+  uint32_t ticks;
+  int lastDirection;
+  uint64_t lastMoveTime;
+  int streak;
+  int lastRedrawMs;
+  bool fist;  // a click is being animated (closed hand)
+};
+State s;
+
+/* ------------------------------------------------------------------ items */
+
+struct BuiltinTile {
+  I18n::Message name;
+  uint8_t tile;
+};
+
+constexpr BuiltinTile k_builtinTiles[] = {
+    {I18n::Message::CalculApp, WinIcons::TileCalculation},
+    {I18n::Message::FunctionApp, WinIcons::TileGraph},
+    {I18n::Message::SolverApp, WinIcons::TileSolver},
+    {I18n::Message::StatsApp, WinIcons::TileStatistics},
+    {I18n::Message::DistributionsApp, WinIcons::TileDistributions},
+    {I18n::Message::SequenceApp, WinIcons::TileSequence},
+    {I18n::Message::RegressionApp, WinIcons::TileRegression},
+    {I18n::Message::InferenceApp, WinIcons::TileInference},
+    {I18n::Message::FinanceApp, WinIcons::TileFinance},
+    {I18n::Message::CodeApp, WinIcons::TileCode},
+    {I18n::Message::ElementsApp, WinIcons::TileElements},
+    {I18n::Message::SettingsApp, WinIcons::TileSettings},
+};
+
+constexpr int k_maxBuiltin = 20;
+int16_t s_builtin[k_maxBuiltin];  // app index in AppsContainer
+uint8_t s_builtinTile[k_maxBuiltin];
+I18n::Message s_builtinName[k_maxBuiltin];
+int s_numberOfBuiltin = 0;
+int s_numberOfGames = 0;
+
+const Escher::App::Descriptor* builtinDescriptor(int appIndex) {
+  return AppsContainer::sharedAppsContainer()
+      ->appSnapshotAtIndex(PermutedAppSnapshotIndex(appIndex))
+      ->descriptor();
+}
+
+void buildItems() {
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  // Index 0 is the home app itself
+  for (int appIndex = 1; appIndex < builtin && s_numberOfBuiltin < k_maxBuiltin;
+       appIndex++) {
+    I18n::Message name = builtinDescriptor(appIndex)->name();
+    uint8_t t = WinIcons::TileCode;
+    for (const BuiltinTile& bt : k_builtinTiles) {
+      if (bt.name == name) {
+        t = bt.tile;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = appIndex;
+    s_builtinTile[s_numberOfBuiltin] = t;
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfExternalApps();
+}
+
+int itemCount() { return s_numberOfBuiltin + s_numberOfGames; }
+
+Item itemAt(int i) {
+  if (i < 0 || i >= itemCount()) {
+    return k_noItem;
+  }
+  if (i < s_numberOfBuiltin) {
+    return {Item::Kind::Builtin, s_builtin[i]};
+  }
+  return {Item::Kind::External, static_cast<int16_t>(i - s_numberOfBuiltin)};
+}
+
+Item builtinNamed(I18n::Message name) {
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    if (s_builtinName[i] == name) {
+      return {Item::Kind::Builtin, s_builtin[i]};
+    }
+  }
+  return k_noItem;
+}
+
+const char* itemLabel(Item item) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      return I18n::translate(builtinDescriptor(item.index)->name());
+    case Item::Kind::External: {
+      const char* name =
+          AppsContainer::sharedAppsContainer()->externalAppAtIndex(item.index)
+              .name();
+      return name ? name : "App";
+    }
+    default:
+      return "";
+  }
+}
+
+void drawItemIcon(Band& b, Item item, int size, int x, int y) {
+  switch (item.kind) {
+    case Item::Kind::Builtin:
+      for (int i = 0; i < s_numberOfBuiltin; i++) {
+        if (s_builtin[i] == item.index) {
+          tile(b, s_builtinTile[i], size, x, y);
+          return;
+        }
+      }
+      tile(b, WinIcons::TileCode, size, x, y);
+      return;
+    case Item::Kind::External:
+      gameIcon(b,
+               AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+                   item.index),
+               x, y, size);
+      return;
+    default:
+      return;
+  }
+}
+
+int pageCount() {
+  int n = (itemCount() + k_cellsPerPage - 1) / k_cellsPerPage;
+  return n < 1 ? 1 : n;
+}
+
+Rect tileRect(int cell) {
+  return {k_gridX + (cell % k_columns) * (k_tileW + k_gapX),
+          k_gridY + (cell / k_columns) * (k_tileH + k_gapY), k_tileW, k_tileH};
+}
+
+Item itemOfCell(int cell) { return itemAt(s.page * k_cellsPerPage + cell); }
+
+/* --------------------------------------------------------------- invalidate */
+
+void invalidate(Rect r) {
+  if (s_invalidator && !r.isEmpty()) {
+    s_invalidator(r);
+  }
+}
+
+void invalidateAll() { invalidate(k_screen); }
+
+Rect pointerRect(int x, int y);  // defined below, with the hand sprite
+
+/* ------------------------------------------------------------------ hit test */
+
+int hitTest(int x, int y) {
+  if (!s.dialog.isNone()) {
+    if (k_startRect.contains(x, y)) {
+      return k_hitStart;
+    }
+    if (k_backRect.contains(x, y)) {
+      return k_hitBack;
+    }
+    return k_hitNone;
+  }
+  if (s.page > 0 && k_prevRect.contains(x, y)) {
+    return k_hitPrev;
+  }
+  if (s.page < pageCount() - 1 && k_nextRect.contains(x, y)) {
+    return k_hitNext;
+  }
+  if (k_wiiRect.contains(x, y)) {
+    return k_hitWii;
+  }
+  if (k_mailRect.contains(x, y)) {
+    return k_hitMail;
+  }
+  if (k_sdRect.contains(x, y)) {
+    return k_hitSD;
+  }
+  for (int cell = 0; cell < k_cellsPerPage; cell++) {
+    if (tileRect(cell).contains(x, y) && !itemOfCell(cell).isNone()) {
+      return k_hitTile + cell;
+    }
+  }
+  return k_hitNone;
+}
+
+Rect hitRect(int key) {
+  if (key >= k_hitTile) {
+    return tileRect(key - k_hitTile).inset(-3);
+  }
+  switch (key) {
+    case k_hitPrev:
+      return k_prevRect;
+    case k_hitNext:
+      return k_nextRect;
+    case k_hitWii:
+      return k_wiiRect.inset(-3);
+    case k_hitMail:
+      return k_mailRect.inset(-3);
+    case k_hitSD:
+      return k_sdRect.inset(-3);
+    case k_hitStart:
+      return k_startRect.inset(-3);
+    case k_hitBack:
+      return k_backRect.inset(-3);
+    default:
+      return {0, 0, 0, 0};
+  }
+}
+
+void setHover(int key) {
+  if (key == s.hover) {
+    return;
+  }
+  invalidate(hitRect(s.hover));
+  s.hover = key;
+  invalidate(hitRect(key));
+}
+
+void refreshHover() { setHover(hitTest(s.cursorX, s.cursorY)); }
+
+/* -------------------------------------------------------------------- misc */
+
+int batteryPercent() {
+  float v = Ion::Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+void requestLaunch(Item item) {
+  if (!item.isNone()) {
+    s_launch = item;
+  }
+}
+
+void sleep() {
+  s.dialog = k_noItem;
+  Ion::Power::suspend(true);
+  AppsContainer::sharedAppsContainer()->didSuspend();
+  invalidateAll();
+}
+
+void openDialog(Item item) {
+  s.dialog = item;
+  s.hover = k_hitNone;
+  invalidateAll();
+  refreshHover();
+}
+
+void closeDialog() {
+  s.dialog = k_noItem;
+  s.hover = k_hitNone;
+  invalidateAll();
+  refreshHover();
+}
+
+void changePage(int delta) {
+  int p = s.page + delta;
+  if (p < 0 || p >= pageCount()) {
+    return;
+  }
+  s.page = p;
+  invalidate(k_gridArea);
+  s.hover = k_hitNone;
+  refreshHover();
+}
+
+void gotoGames() {
+  // The SD card button: jump to the first page that holds a .nwa game
+  if (s_numberOfGames <= 0) {
+    return;
+  }
+  int p = s_numberOfBuiltin / k_cellsPerPage;
+  if (p >= pageCount()) {
+    p = pageCount() - 1;
+  }
+  if (p != s.page) {
+    s.page = p;
+    invalidate(k_gridArea);
+    s.hover = k_hitNone;
+    refreshHover();
+  }
+}
+
+void click(bool secondary) {
+  int h = s.hover;
+  if (!secondary) {
+    // Click animation: the hand closes until the next tick (and the target
+    // lights up)
+    s.fist = true;
+    invalidate(pointerRect(s.cursorX, s.cursorY));
+    invalidate(hitRect(h));
+  }
+  if (secondary) {
+    return;
+  }
+  if (h >= k_hitTile) {
+    openDialog(itemOfCell(h - k_hitTile));
+    return;
+  }
+  switch (h) {
+    case k_hitPrev:
+      changePage(-1);
+      break;
+    case k_hitNext:
+      changePage(1);
+      break;
+    case k_hitWii:
+      requestLaunch(builtinNamed(I18n::Message::SettingsApp));
+      break;
+    case k_hitMail:
+      sleep();
+      break;
+    case k_hitSD:
+      gotoGames();
+      break;
+    case k_hitStart: {
+      Item it = s.dialog;
+      s.dialog = k_noItem;
+      requestLaunch(it);
+      break;
+    }
+    case k_hitBack:
+      closeDialog();
+      break;
+    default:
+      break;
+  }
+}
+
+void movePointer(int dx, int dy, int direction) {
+  uint64_t now = Ion::Timing::millis();
+  if (direction == s.lastDirection && now - s.lastMoveTime < 260) {
+    if (s.streak < 12) {
+      s.streak++;
+    }
+  } else {
+    s.streak = 0;
+  }
+  s.lastDirection = direction;
+  s.lastMoveTime = now;
+  int step = 4 + s.streak * 2;
+  invalidate(pointerRect(s.cursorX, s.cursorY));
+  s.cursorX += dx * step;
+  s.cursorY += dy * step;
+  if (s.cursorX < 0) s.cursorX = 0;
+  if (s.cursorY < 0) s.cursorY = 0;
+  if (s.cursorX > k_screenWidth - 1) s.cursorX = k_screenWidth - 1;
+  if (s.cursorY > k_screenHeight - 1) s.cursorY = k_screenHeight - 1;
+  invalidate(pointerRect(s.cursorX, s.cursorY));
+  refreshHover();
+}
+
+/* ------------------------------------------------------------------ drawing */
+
+bool visible(const Band& b, Rect r) { return r.intersects(b.area()); }
+
+void drawBackground(Band& b) {
+  fill(b, b.area(), background());
+  int top = b.area().y;
+  int y = top + (top & 1);
+  for (; y < b.area().bottom(); y += 2) {
+    fill(b, {0, y, k_screenWidth, 1}, backgroundStripe());
+  }
+}
+
+/* ------------------------------------------------------------ channel tiles */
+
+/* ------------------------------------------------------- cushion tile shape */
+
+/* The channel tiles of the Wii Menu are not plain rounded rectangles: their
+ * edges bulge a little ("cushion"). The shape is a superellipse
+ * |x/a|^N + |y/b|^N <= 1, antialiased with 4 sub-rows per pixel row. The
+ * spans of each shape are computed once (a few hundred bytes each). */
+constexpr int k_shapeN = 6;
+constexpr int k_shapeRows = k_tileH + 8;
+
+struct Shape {
+  int rowStart;
+  int rows;
+  int16_t xl[4 * k_shapeRows];  // 1/16 pixel
+  int16_t xr[4 * k_shapeRows];
+};
+
+Shape s_outer, s_in1, s_in2, s_grow;
+bool s_shapesReady = false;
+
+void buildShape(Shape& sh, float sw, float shh, float ox, float oy) {
+  sh.rowStart = static_cast<int>(floorf(oy));
+  sh.rows = static_cast<int>(ceilf(oy + shh)) - sh.rowStart;
+  if (sh.rows > k_shapeRows) {
+    sh.rows = k_shapeRows;
+  }
+  for (int r = 0; r < sh.rows; r++) {
+    for (int k = 0; k < 4; k++) {
+      float yc = sh.rowStart + r + (k + 0.5f) / 4.f;
+      float dy = fabsf(yc - (oy + shh / 2.f)) / (shh / 2.f);
+      int idx = r * 4 + k;
+      if (dy >= 1.f) {
+        sh.xl[idx] = 1;
+        sh.xr[idx] = 0;
+        continue;
+      }
+      float p = dy * dy;
+      p = p * p * p;  // dy^6 (k_shapeN)
+      float half = (sw / 2.f) * powf(1.f - p, 1.f / k_shapeN);
+      float cx = ox + sw / 2.f;
+      sh.xl[idx] = static_cast<int16_t>((cx - half) * 16.f);
+      sh.xr[idx] = static_cast<int16_t>((cx + half) * 16.f);
+    }
+  }
+}
+
+void prepareShapes() {
+  if (s_shapesReady) {
+    return;
+  }
+  s_shapesReady = true;
+  buildShape(s_outer, k_tileW, k_tileH, 0, 0);
+  buildShape(s_in1, k_tileW - 3, k_tileH - 3, 1.5f, 1.5f);
+  buildShape(s_in2, k_tileW - 7, k_tileH - 7, 3.5f, 3.5f);
+  buildShape(s_grow, k_tileW + 4, k_tileH + 4, -2, -2);
+}
+
+// Coverage 0..255 of pixel (x, row) (tile coordinates) by the shape
+int shapeCoverage(const Shape& sh, int x, int row) {
+  int r = row - sh.rowStart;
+  if (r < 0 || r >= sh.rows) {
+    return 0;
+  }
+  int sum = 0;
+  int x0 = x * 16, x1 = x0 + 16;
+  for (int k = 0; k < 4; k++) {
+    int lo = sh.xl[r * 4 + k] > x0 ? sh.xl[r * 4 + k] : x0;
+    int hi = sh.xr[r * 4 + k] < x1 ? sh.xr[r * 4 + k] : x1;
+    if (hi > lo) {
+      sum += hi - lo;
+    }
+  }
+  int c = sum * 4;
+  return c > 255 ? 255 : c;
+}
+
+/* Paints colour c where `sh` covers and `hole` does not. parity: -1 = every
+ * row, 0 / 1 = only the rows whose (y & 1) equals it (micro lines). */
+void shapeLayer(Band& b, int tx, int ty, const Shape& sh, const Shape* hole,
+                KDColor c, int alpha, int parity = -1) {
+  int y0 = ty + sh.rowStart;
+  Rect box = {tx - 3, y0, k_tileW + 6, sh.rows};
+  Rect z = box.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    if (parity >= 0 && (y & 1) != parity) {
+      continue;
+    }
+    KDColor* row = b.row(y);
+    int trow = y - ty;
+    for (int x = z.x; x < z.right(); x++) {
+      int cov = shapeCoverage(sh, x - tx, trow);
+      if (cov == 0) {
+        continue;
+      }
+      if (hole) {
+        cov -= shapeCoverage(*hole, x - tx, trow);
+        if (cov <= 0) {
+          continue;
+        }
+      }
+      int a = cov * alpha / 255;
+      if (a >= 255) {
+        row[x] = c;
+      } else if (a > 0) {
+        row[x] = KDColor::Blend(c, row[x], static_cast<uint8_t>(a));
+      }
+    }
+  }
+}
+
+void drawEmptyTile(Band& b, Rect r) {
+  prepareShapes();
+  shapeLayer(b, r.x, r.y, s_outer, nullptr, rgb(0xDEDEDE), 255);
+  shapeLayer(b, r.x, r.y, s_in1, nullptr, rgb(0xD3D3D3), 255, 0);   // micro lines
+  shapeLayer(b, r.x, r.y, s_in1, nullptr, rgb(0xE6E6E6), 255, 1);
+  shapeLayer(b, r.x, r.y, s_outer, &s_in1, rgb(0xBFBFBF), 255);       // border
+  text(b, "Wii", r.x + r.w / 2, r.y + r.h / 2 - 9, rgb(0xD0D0D0),
+       KDFont::Size::Large, Align::Center);
+}
+
+void drawCell(Band& b, int cell) {
+  Rect r = tileRect(cell);
+  if (!visible(b, r.inset(-4))) {
+    return;
+  }
+  Item it = itemOfCell(cell);
+  if (it.isNone()) {
+    drawEmptyTile(b, r);
+    return;
+  }
+  prepareShapes();
+  bool hot = s.hover == k_hitTile + cell;
+  shapeLayer(b, r.x, r.y, s_outer, nullptr, KDWhite, 255);
+  // Very fine horizontal lines, like the screen of the real channels
+  shapeLayer(b, r.x, r.y, s_in1, nullptr, rgb(0xEEF2F5), 255, 1);
+  fill(b, {r.x + 3, r.y + r.h - 14, r.w - 6, 11}, rgb(0xEAF4F9), 200);
+  drawItemIcon(b, it, 24, r.x + (r.w - 24) / 2, r.y + 4);
+  text(b, itemLabel(it), r.x + r.w / 2, r.y + 30, textTile(), Small,
+       Align::Center, r.w - 4);
+  shapeLayer(b, r.x, r.y, s_outer, &s_in1, rgb(0xB9BFC4), 255);
+  if (hot) {
+    shapeLayer(b, r.x, r.y, s_grow, &s_outer, accent(), 110);
+    shapeLayer(b, r.x, r.y, s_outer, &s_in1, accent(), 255);
+    shapeLayer(b, r.x, r.y, s_in1, &s_in2, accent(), 150);
+    if (s.fist) {
+      shapeLayer(b, r.x, r.y, s_in1, nullptr, accent(), 80);
+    }
+  }
+}
+
+void drawPeek(Band& b, bool right) {
+  for (int row = 0; row < k_rows; row++) {
+    Rect r = {right ? k_gridX + k_columns * (k_tileW + k_gapX)
+                    : k_gridX - (k_tileW + k_gapX),
+              k_gridY + row * (k_tileH + k_gapY), k_tileW, k_tileH};
+    if (visible(b, r)) {
+      drawEmptyTile(b, r);
+    }
+  }
+}
+
+void drawArrow(Band& b, Rect hit, bool next, bool hot) {
+  if (!visible(b, hit)) {
+    return;
+  }
+  KDColor c = hot ? accentDark() : accent();
+  int x = hit.x + 3;
+  int y = hit.y + 13;
+  for (int j = 0; j < 19; j++) {
+    int w = (j < 9 ? j : 18 - j) + 1;
+    int xx = next ? x : x + 10 - w;
+    fill(b, {xx - 1, y + j, w + 2, 1}, KDWhite, 200);
+    fill(b, {xx, y + j, w, 1}, c);
+  }
+}
+
+/* ----------------------------------------------------------------- the bar */
+
+/* The top edge of the bar: flat on the sides, and a smooth dip under the
+ * clock (k_dip pixels deep), like the real Wii Menu. */
+uint8_t s_edge[k_screenWidth];      // integer edge (body)
+uint16_t s_edgeF[k_screenWidth];    // edge in 1/8 pixel (smooth line)
+bool s_edgeReady = false;
+
+void prepareEdge() {
+  if (s_edgeReady) {
+    return;
+  }
+  s_edgeReady = true;
+  constexpr int x0 = 59, x1 = 112, x2 = 208, x3 = 267;
+  for (int x = 0; x < k_screenWidth; x++) {
+    float t;
+    if (x <= x0 || x >= x3) {
+      t = 0.f;
+    } else if (x >= x1 && x <= x2) {
+      t = 1.f;
+    } else if (x < x1) {
+      t = (x - x0) / static_cast<float>(x1 - x0);
+    } else {
+      t = (x3 - x) / static_cast<float>(x3 - x2);
+    }
+    float smooth = 0.5f - 0.5f * cosf(t * 3.14159265f);
+    int e = k_barY + static_cast<int>(k_dip * smooth + (k_dip >= 0 ? 0.5f : -0.5f));
+    s_edge[x] = static_cast<uint8_t>(e);
+    s_edgeF[x] = static_cast<uint16_t>((k_barY + k_dip * smooth) * 8.f + 0.5f);
+  }
+}
+
+KDColor mix(uint32_t a, uint32_t c, int t, int total) {
+  int ra = (a >> 16) & 255, ga = (a >> 8) & 255, ba = a & 255;
+  int rc = (c >> 16) & 255, gc = (c >> 8) & 255, bc = c & 255;
+  return KDColor::RGB888(static_cast<uint8_t>(ra + (rc - ra) * t / total),
+                         static_cast<uint8_t>(ga + (gc - ga) * t / total),
+                         static_cast<uint8_t>(ba + (bc - ba) * t / total));
+}
+
+void drawBarBody(Band& b) {
+  prepareEdge();
+  // Body: a pale lavender-grey gradient from the edge to the bottom, drawn
+  // in runs of columns that share the same edge, 3 pixel rows at a time
+  int x = 0;
+  while (x < k_screenWidth) {
+    int e = s_edge[x];
+    int end = x + 1;
+    while (end < k_screenWidth && s_edge[end] == e) {
+      end++;
+    }
+    int span = k_screenHeight - e;
+    for (int y = e; y < k_screenHeight; y += 3) {
+      int h = k_screenHeight - y < 3 ? k_screenHeight - y : 3;
+      fill(b, {x, y, end - x, h}, mix(0xF1F1F5, 0xCDCDD6, y - e, span));
+    }
+    x = end;
+  }
+  // Thin blue edge, antialiased (about 2 pixels, thicker on the slopes), with
+  // a soft grey shade right under it
+  for (int cx = 0; cx < k_screenWidth; cx++) {
+    int e8 = s_edgeF[cx];
+    int prev = s_edgeF[cx > 0 ? cx - 1 : 0];
+    int next = s_edgeF[cx < k_screenWidth - 1 ? cx + 1 : cx];
+    int slope = (next > prev ? next - prev : prev - next) / 2;  // 1/8 px per px
+    int top8 = e8 - 8;                                          // line is centered
+    int bottom8 = e8 + 13 + slope;                              // ~2.6 px + slope
+    int yTop = top8 >> 3;
+    int yBottom = (bottom8 + 7) >> 3;
+    for (int y = yTop; y <= yBottom; y++) {
+      int lo = top8 > y * 8 ? top8 : y * 8;
+      int hi = bottom8 < y * 8 + 8 ? bottom8 : y * 8 + 8;
+      if (hi > lo) {
+        fill(b, {cx, y, 1, 1}, accent(), (hi - lo) * 256 / 8);
+      }
+    }
+    int sh = (e8 + 13 + slope + 7) >> 3;
+    fill(b, {cx, sh, 1, 1}, rgb(0x9A9AA6), 60);
+    fill(b, {cx, sh + 1, 1, 2}, rgb(0x9A9AA6), 32);
+    fill(b, {cx, sh + 3, 1, 2}, rgb(0x9A9AA6), 14);
+  }
+}
+
+/* Seven-segment digits, thin and grey, like the Wii clock */
+constexpr uint8_t k_segments[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66,
+                                    0x6D, 0x7D, 0x07, 0x7F, 0x6F};
+constexpr int k_digitW = 13;
+constexpr int k_digitH = 18;
+constexpr int k_digitGap = 5;
+
+void seg(Band& b, Rect r, KDColor edge, KDColor inner) {
+  fill(b, r, edge);
+  fill(b, r.inset(1), inner);
+}
+
+void drawDigit(Band& b, int d, int x, int y, KDColor c) {
+  uint8_t m = k_segments[d];
+  constexpr int t = 3;
+  constexpr int w = k_digitW, h = k_digitH, mid = h / 2;
+  KDColor inner = rgb(0xE9E9E9);
+  if (m & 0x01) seg(b, {x + 1, y, w - 2, t}, c, inner);                    // a
+  if (m & 0x02) seg(b, {x + w - t, y + 1, t, mid}, c, inner);              // b
+  if (m & 0x04) seg(b, {x + w - t, y + mid, t, mid - 1}, c, inner);        // c
+  if (m & 0x08) seg(b, {x + 1, y + h - t - 1, w - 2, t}, c, inner);        // d
+  if (m & 0x10) seg(b, {x, y + mid, t, mid - 1}, c, inner);                // e
+  if (m & 0x20) seg(b, {x, y + 1, t, mid}, c, inner);                      // f
+  if (m & 0x40) seg(b, {x + 1, y + mid - 2, w - 2, t}, c, inner);          // g
+}
+
+void drawRoundButton(Band& b, Rect r, bool hot) {
+  // The groove the button sits in (soft)
+  roundFill(b, r.inset(-7), 27, KDBlack, 8);
+  roundFrame(b, r.inset(-7), 27, rgb(0x8E8E9A), 38);
+  roundFrame(b, r.inset(-6), 26, KDWhite, 110);
+  // Button: soft white-to-grey body, glossy highlight, thin pale-blue ring
+  roundFill(b, r, 20, rgb(0xE4E1E2));
+  roundFill(b, {r.x + 3, r.y + 2, r.w - 8, r.h - 9}, 17, rgb(0xF6F5F5), 220);
+  roundFrame(b, r, 20, rgb(0x8EC6D9));
+  roundFrame(b, r.inset(1), 19, rgb(0xA9D5E4), 170);
+  if (hot) {
+    if (s.fist) {
+      roundFill(b, r.inset(2), 18, accent(), 90);
+    }
+    roundFrame(b, r.inset(-1), 21, accent(), 200);
+    roundFrame(b, r.inset(-2), 22, accent(), 90);
+  }
+}
+
+void drawEnvelope(Band& b, int cx, int cy) {
+  Rect body = {cx - 11, cy - 7, 22, 15};
+  fill(b, body, rgb(0xF9F9F9));
+  frame(b, body, rgb(0xA9AEB3));
+  for (int i = 0; i < 11; i++) {
+    int y = cy - 6 + i * 7 / 11;
+    fill(b, {cx - 10 + i, y, 1, 1}, rgb(0xA9AEB3));
+    fill(b, {cx + 10 - i, y, 1, 1}, rgb(0xA9AEB3));
+  }
+}
+
+void drawSDCard(Band& b, Rect hit, bool hot) {
+  Rect c = {hit.x + 5, hit.y + 3, 15, 21};
+  if (hot) {
+    roundFill(b, c.inset(-3), 4, accent(), 45);
+  }
+  KDColor edge = rgb(0x8C8C93);
+  fill(b, c, KDWhite);
+  fill(b, {c.x + 1, c.bottom() - 6, c.w - 2, 5}, rgb(0xB4B4BA));
+  frame(b, c, edge);
+  // Cut corner (top right)
+  for (int j = 0; j < 4; j++) {
+    fill(b, {c.right() - (4 - j), c.y + j, 4 - j, 1}, rgb(0xDDDDE3));
+    fill(b, {c.right() - (4 - j), c.y + j, 1, 1}, edge);
+  }
+  fill(b, {c.x + 4, c.y + 9, 7, 2}, rgb(0xC9C9CF));
+}
+
+// "%" sign in the same thin outlined style as the digits
+void drawPercent(Band& b, int x, int y, KDColor c) {
+  constexpr int h = 18;
+  frame(b, {x, y + 1, 5, 5}, c);
+  frame(b, {x + 7, y + h - 6, 5, 5}, c);
+  for (int i = 0; i < h - 2; i++) {
+    fill(b, {x + 10 - i * 8 / (h - 3), y + 1 + i, 2, 1}, c);
+  }
+}
+
+// Battery gauge: a long rounded body with a nub, filled from the left
+void drawBatteryGauge(Band& b, Rect r, int pct, bool charging) {
+  KDColor edge = rgb(0xA6A6A6);
+  KDColor fillColor = charging ? rgb(0x6CCB5F)
+                               : (pct <= 15 ? rgb(0xE81123) : accent());
+  roundFill(b, r, 6, rgb(0xF4F4F5));
+  Rect in = r.inset(3);
+  int w = in.w * pct / 100;
+  if (w >= 6) {
+    roundFill(b, {in.x, in.y, w, in.h}, 4, fillColor);
+    roundFill(b, {in.x + 1, in.y + 1, w - 2, in.h / 2 - 1}, 3, KDWhite, 90);
+  } else if (w > 0) {
+    fill(b, {in.x, in.y + 1, w, in.h - 2}, fillColor);
+  }
+  roundFrame(b, r, 6, edge);
+  roundFrame(b, r.inset(1), 5, KDWhite, 150);
+  roundFill(b, {r.right(), r.y + r.h / 2 - 3, 3, 7}, 2, edge);
+}
+
+void drawBottomBar(Band& b) {
+  if (!visible(b, {0, 170, k_screenWidth, 70})) {
+    return;
+  }
+  drawBarBody(b);
+
+  drawRoundButton(b, k_wiiRect, s.hover == k_hitWii);
+  text(b, "Wii", k_wiiRect.x + 20, k_wiiRect.y + 11, rgb(0xB2B2B2),
+       KDFont::Size::Large, Align::Center);
+  text(b, "Wii", k_wiiRect.x + 21, k_wiiRect.y + 11, rgb(0xB2B2B2),
+       KDFont::Size::Large, Align::Center);
+  drawRoundButton(b, k_mailRect, s.hover == k_hitMail);
+  drawEnvelope(b, k_mailRect.x + 20, k_mailRect.y + 15);
+  text(b, "1", k_mailRect.x + 20, k_mailRect.y + 24, textDim(), Small,
+       Align::Center);
+  drawSDCard(b, k_sdRect, s.hover == k_hitSD);
+
+  // Battery level in the dip: big thin digits with a "%" sign, and the
+  // gauge right below it, inside the bar.
+  int pct = s.lastBattery;
+  KDColor cc = clockColor();
+  constexpr int y = 175;
+  int n = pct >= 100 ? 3 : (pct >= 10 ? 2 : 1);
+  constexpr int pw = 12;  // width of the "%" sign
+  int total = n * k_digitW + (n - 1) * k_digitGap + 6 + pw;
+  int x = 160 - total / 2;
+  int digits[3] = {pct / 100, (pct / 10) % 10, pct % 10};
+  for (int i = 0; i < n; i++) {
+    drawDigit(b, digits[3 - n + i], x + i * (k_digitW + k_digitGap), y, cc);
+  }
+  drawPercent(b, x + n * (k_digitW + k_digitGap) + 1, y, cc);
+  drawBatteryGauge(b, {124, 201, 69, 15}, pct, Ion::Battery::isCharging());
+}
